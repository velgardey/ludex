# Public Expo build-time settings. No server credentials belong in EXPO_PUBLIC variables.
# ACTIVE: Android emulator; physical phone needs your reachable LAN/HTTPS API URL.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api
# ACTIVE: shared-link origin allowlist. No production domain selected yet.
EXPO_PUBLIC_WEB_ORIGIN=http://localhost:3001
# RESERVED: Credential Manager direct native sign-in. Current app uses backend Web OAuth + PKCE handoff.
# Android client must match com.ludex.app and each installed signing certificate SHA-1.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# The current Web client ID/secret are read by the Go server, not these public reservations.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# PLANNED: file path to Android Firebase config; app.config.ts does not read it yet.
# Save file in apps/mobile/.local/firebase/google-services.json.
LUDEX_ANDROID_GOOGLE_SERVICES_FILE=
