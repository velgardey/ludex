# Go backend; explicit --env .env.local. Examples contain no provider credentials.
LUDEX_ENV=development
PORT=4000
LUDEX_HOST=127.0.0.1
DATABASE_URL=postgresql://localhost:55432/ludex_dev?sslmode=disable
DIRECT_URL=postgresql://localhost:55432/ludex_dev?sslmode=disable
LUDEX_DATABASE_MAX_CONNECTIONS=4
LUDEX_LOCAL_INVITE=
LUDEX_WEB_ORIGIN=http://localhost:3001
LUDEX_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
LUDEX_MODERATOR_EMAILS=
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
STEAM_WEB_API_KEY=
# Reserved: continuous Trakt/RetroAchievements/FCM adapters are not enabled yet.
TRAKT_CLIENT_ID=
TRAKT_REDIRECT_URI=
FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# RetroAchievements access is per-user encrypted connection data, not a global key.
# Reserved for future media storage; current exports are authenticated JSON.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER=ludex-user-media
AZURE_STORAGE_CONNECTION_STRING=
LUDEX_TOKEN_ENCRYPTION_KEY=
AZURE_OPENAI_ENDPOINT=https://thehub.services.ai.azure.com/openai/v1
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-6-luna
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_API_KEY=
LUDEX_AI_ENABLED=false
LUDEX_AI_MAX_INPUT_TOKENS=4000
LUDEX_AI_MAX_OUTPUT_TOKENS=600
LUDEX_AI_INPUT_USD_PER_MILLION_TOKENS=
LUDEX_AI_OUTPUT_USD_PER_MILLION_TOKENS=
LUDEX_AI_EMBEDDING_USD_PER_MILLION_TOKENS=
# Monthly limits are currently fixed in cmd/ludex: $5 shared,20 replies/user/month.
# Review deployment-specific prices including billed reasoning tokens before enabling.
