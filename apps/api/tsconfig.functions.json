{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "rootDir": "../..",
    "types": ["node"]
  },
  "include": [
    "src/functions/**/*.ts",
    "src/service.ts",
    "src/http.ts",
    "src/auth/**/*.ts",
    "src/store/cosmos.ts",
    "src/catalog/**/*.ts",
    "../../packages/domain/src/**/*.ts",
    "../../packages/contracts/src/**/*.ts"
  ]
}
