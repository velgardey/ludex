{
  "version": "2.0",
  "logging": {
    "logLevel": { "default": "Warning", "Function": "Information" },
    "applicationInsights": {
      "samplingSettings": { "isEnabled": true, "excludedTypes": "Request" }
    }
  },
  "extensions": {
    "http": {
      "routePrefix": "api",
      "maxOutstandingRequests": 200,
      "maxConcurrentRequests": 20,
      "dynamicThrottlesEnabled": true
    }
  }
}
