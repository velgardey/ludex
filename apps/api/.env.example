# Local development only. Production server rejects local auth.
PORT=4000
LUDEX_HOST=127.0.0.1
LUDEX_DB_PATH=.local/ludex.sqlite
LUDEX_AUTH_MODE=local
LUDEX_LOCAL_INVITE=LUDEX-LOCAL-BETA
LUDEX_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LUDEX_MODERATOR_EMAILS=
