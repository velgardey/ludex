# Ludex SERVER configuration. Copy to .env.local; never copy into web/mobile.
# Sections marked PLANNED are reservations, not working integrations.
# Current Stage A server still uses SQLite/local login. See docs/setup/credentials.md.

# ACTIVE: local Stage A
PORT=4000
LUDEX_HOST=127.0.0.1
LUDEX_DB_PATH=.local/ludex.sqlite
LUDEX_AUTH_MODE=local
# Public local-only sample invite; never use for a hosted beta.
LUDEX_LOCAL_INVITE=LUDEX-LOCAL-BETA
LUDEX_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
LUDEX_MODERATOR_EMAILS=

# PLANNED: public deployment URLs (no domain selected)
LUDEX_WEB_ORIGIN=
LUDEX_API_ORIGIN=

# PLANNED: Supabase PostgreSQL through Prisma (no Supabase Auth)
# Runtime transaction pooler :6543; connection settings depend on chosen Prisma version.
DATABASE_URL=
# Migration connection: supplied Supabase session pooler :5432, not the direct DB host.
DIRECT_URL=
# Choose an isolated schema before any migration against an existing database.
LUDEX_DATABASE_SCHEMA=

# PLANNED: direct Google OAuth; web secret belongs on this server only.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=
# Proposed backend callback; must be implemented and registered exactly in Google.
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# Generated for Ludex sessions and encrypted connector tokens, not provider API keys.
LUDEX_SESSION_SECRET=
LUDEX_TOKEN_ENCRYPTION_KEY=

# PLANNED: movie/TV metadata. Fill API key OR read access token.
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# PLANNED: IGDB metadata, app token minted server-side (no Twitch user sign-in).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# PLANNED: Steam app-level Web API key; users link SteamID through OpenID.
STEAM_WEB_API_KEY=
# PLANNED: Trakt import via per-user PKCE OAuth; current docs deprecate sign-in secret.
TRAKT_CLIENT_ID=
TRAKT_REDIRECT_URI=http://localhost:4000/api/connections/trakt/callback
# RetroAchievements keys are per-user encrypted connection data, never one global key.

# PLANNED: Azure OpenAI v1. Exact deployment names selected by the user.
AZURE_OPENAI_ENDPOINT=https://thehub.services.ai.azure.com/openai/v1
AZURE_OPENAI_AUTH_MODE=api_key
AZURE_OPENAI_API_KEY=
# Only needed for a configured user-assigned managed identity.
AZURE_OPENAI_MANAGED_IDENTITY_CLIENT_ID=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-6-luna
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# Proposed reduced output size; validate model support and pgvector index limits first.
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1024
# Proposed controls: no cloud requests until implementation and model rates are verified.
LUDEX_AI_ENABLED=false
LUDEX_AI_MONTHLY_BUDGET_USD=5
LUDEX_AI_RESPONSES_PER_USER_MONTH=20
LUDEX_AI_MAX_INPUT_TOKENS=4000
LUDEX_AI_MAX_OUTPUT_TOKENS=600
LUDEX_AI_CONFIRM_EVERY_WRITE=true
# Fill deployment-specific rates for a real spend ledger; credits do not make usage free.
LUDEX_AI_INPUT_USD_PER_MILLION_TOKENS=
LUDEX_AI_OUTPUT_USD_PER_MILLION_TOKENS=
LUDEX_AI_EMBEDDING_USD_PER_MILLION_TOKENS=

# PLANNED: Android FCM. Prefer workload identity; otherwise protected file, not inline JSON.
FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# PLANNED: cloud avatar/export storage; prefer managed identity to connection string.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER=ludex-user-media
AZURE_STORAGE_CONNECTION_STRING=

# EXISTING alternate OIDC/Cosmos Functions path; NOT the selected Google/Prisma target.
# Leave blank for local Stage A. Do not deploy current Cosmos Bicep as a Postgres release.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
COSMOS_CONNECTION_STRING=
COSMOS_DATABASE=
COSMOS_CONTAINER=
